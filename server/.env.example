# FinAgent Backend — Environment Variables
# Copy this file to .env and fill in your keys

# Google Gemini API Key (Get free at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# NewsAPI Key (Get free at: https://newsapi.org/register)
NEWS_API_KEY=your_newsapi_key_here

# Server port (default 3001)
PORT=3001

# Razorpay Credentials (Optional for payment processing)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Resend Email API Key (Optional for transactional emails)
RESEND_API_KEY=your_resend_api_key
