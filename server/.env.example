# FinAgent Backend — Environment Variables Template
# Copy this file to .env and fill in your keys

# Google Gemini API Key (Get free at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# NewsAPI Key (Get free at: https://newsapi.org/register)
NEWS_API_KEY=your_newsapi_key_here

# Server port (default 3001)
PORT=3001

# Razorpay Credentials (Optional for payment processing)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Resend Email API Key (Optional for transactional emails)
RESEND_API_KEY=your_resend_api_key

# Alpaca Paper Trading Credentials
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_ENDPOINT=https://paper-api.alpaca.markets

# Plaid Sandbox Credentials
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# Stripe Subscriptions & Billing
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PRO_PRICE_ID=price_your_pro_id
STRIPE_ADVISOR_PRICE_ID=price_your_advisor_id
STRIPE_BLACK_PRICE_ID=price_your_black_id

# Supabase PostgreSQL Cloud Database (Pooler Connection URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres
